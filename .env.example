# Copy this file to .env when overriding the local defaults.
# Docker Compose reads .env automatically. Configure the same variables in
# your IDE or shell when running Spring Boot outside Docker Compose.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plimap_local_db
DB_USERNAME=plimap
DB_PASSWORD=plimap1234

REDIS_HOST=localhost
REDIS_PORT=6379

# 쉼표로 구분한 프론트엔드 Origin 목록입니다.
# 프로토콜과 포트를 포함하고 경로 및 마지막 슬래시는 제외합니다.
# local/dev/prod에서 같은 변수 이름에 해당 환경의 프론트 Origin을 주입합니다.
# 예: http://localhost:3000 또는 https://app.plimap.com
CORS_ALLOWED_ORIGINS=
